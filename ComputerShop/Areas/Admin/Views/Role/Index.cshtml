@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

@{
    ViewData["title"] = "Roles Listed";
}

<h3>List Roles</h3>
<a class="btn btn-primary" asp-action="Create" asp-controller="Role">Add Role</a>
<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Role Name</th>

            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th>@item.Id</th>
                <td>@item.Name</td>
                <td class="inline-buttons">
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Role" asp-route-id="@item.Id">Edit</a>
                    <form asp-action="Delete" asp-controller="Role" asp-route-id="@item.Id" method="post" class="d-inline-block" onsubmit="return confirm('Are you sure you want to delete this Role?');">
                        <button type="submit" class="btn btn-danger btn-sm confirmDeletion">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
