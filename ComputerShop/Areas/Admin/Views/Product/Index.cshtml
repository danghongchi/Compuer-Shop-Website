@model IEnumerable<ProductModel>
@{
    ViewData["title"] = "Product Listed";
    Paginate pager = ViewBag.Pager ?? new Paginate();  // Sử dụng giá trị mặc định nếu ViewBag.Pager là null
    int pageNo = pager.CurrentPage;
}

<h3>List Product</h3>
<a asp-action="Create" asp-controller="Product">Add Product</a>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Product Name</th>
            <th scope="col">Product Description</th>
            <th scope="col">Product Price</th>
            <th scope="col">Product Image</th>
            <th scope="col">Product Slug</th>
            <th scope="col">Product Category</th>
            <th scope="col">Product Brand</th>
            <th scope="col">Product Manage</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td>@Html.Raw(item.Description)</td>
                <td>@item.Price.ToString("#,##0 VND")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="~/media/products/@item.Image" width="120" />
                    }
                    else
                    {
                        <img src="~/media/products/default-image.jpg" width="120" />
                    }
                </td>
                <td>@item.Slug</td>
                <td>@(item.Category != null ? item.Category.Name : "N/A")</td>
                <td>@(item.Brand != null ? item.Brand.Name : "N/A")</td>
                <td class="inline-buttons">
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Product" asp-route-id="@item.Id">Edit</a>
                    <form asp-action="Delete" asp-controller="Product" asp-route-id="@item.Id" method="post" class="d-inline-block" onsubmit="return confirm('Are you sure you want to delete this Product?');">
                        <button type="submit" class="btn btn-danger btn-sm confirmDeletion">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_paging" model="@pager" />
