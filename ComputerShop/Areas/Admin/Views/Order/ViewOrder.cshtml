@model IEnumerable<OrderDetails>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    decimal total = 0;
    decimal subtotal = 0;
    string orderCode = Model.FirstOrDefault()?.OrderCode ?? ""; // Lấy OrderCode từ item đầu tiên nếu có
}

<h3>Order Details</h3>

<table class="table" id="detail_order">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">OrderCode</th>
            <th scope="col">UserName</th>
            <th scope="col">Product Name</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
            <th scope="col">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            subtotal = item.Quantity * item.Price;
            total += subtotal;
            <tr>
                <input type="hidden" value="@item.OrderCode" class="getId" />
                <th>@item.Id</th>
                <td>@item.OrderCode</td>
                <td>@item.UserName</td>
                <td>@item.Product.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@subtotal.ToString("C")</td>
            </tr>
        }
        <tr>
            <th colspan="5">Total:</th>
            <td colspan="2">@total.ToString("C")</td>
        </tr>
        <tr>
            <th colspan="5">Cập nhật trạng thái đơn hàng:</th>
            <td colspan="2">
                <select class="form-control select-update-order">
                    <option value="1">Đơn hàng mới</option>
                    <option value="0">Đã xử lý</option>
                </select>
            </td>
        </tr>
    </tbody>
    <a class="btn btn-primary" asp-action="Index" >Back to List Orders</a>

</table>

@section Scripts {
    <script>
        let table = new DataTable('#detail_order', {
            layout: {
                topStart: {
                    buttons: [ 'excel', 'pdf', 'print']
                }
            }
        });
    </script>
    <script>
        $(document).ready(function () {
            $('.select-update-order').change(function () {
                var status = $(this).val();
                var orderCode = '@orderCode'; // Lấy giá trị orderCode từ C#

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateOrder", "Order", new { area = "Admin" })", // Chú ý thêm area
                    data: { status: status, orderCode: orderCode },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire("Cập nhật đơn hàng thành công");
                        } else {
                            Swal.fire("Cập nhật đơn hàng thất bại: " + result.message);
                        }
                    },
                    error: function (req, status, error) {
                        console.error("Error updating order:", error);
                    }
                });
            });
        });
    </script>
}
