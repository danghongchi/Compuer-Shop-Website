@model IEnumerable<SliderModel>
@{
    ViewData["title"] = "Slider Listed";
   /* Paginate pager = new Paginate();
     int pageNo = 0;
     if (ViewBag.Pager != null)
         {
         pager = ViewBag.Pager;
         pageNo = pager.CurrentPage;
    }*/
}
<h3>List Slider</h3>
<a  asp-action="Create" asp-controller="Slider">Add Slider</a>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Slider Name</th>
            <th scope="col">Slider Description</th>
            <th scope="col">Slider Image</th>
            <th scope="col">Slider Status</th>
            <th scope="col">Actions</th> <!-- Thêm cột này -->
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td>@Html.Raw(item.Description)</td>
                
                <td>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="~/media/sliders/@item.Image" width="400" height="120" />
                    }
                    else
                    {
                        <img src="~/media/sliders/default-image.jpg" width="400" height="120" />
                    }
                </td>
                <td>
                    @if (@item.Status == 1)
                    {
                        <span class="text text-success">Hiển thị</span>
                    }
                    else
                    {
                        <span class="text text-danger">Ẩn</span>
                    }
                </td>
                <td class="inline-buttons">
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Slider" asp-route-id="@item.Id">Edit</a>
                    <form asp-action="Delete" asp-controller="Slider" asp-route-id="@item.Id" method="post" class="d-inline-block" onsubmit="return confirm('Are you sure you want to delete ?');">
                        <button type="submit" class="btn btn-danger btn-sm confirmDeletion">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

