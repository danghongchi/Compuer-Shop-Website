@using ComputerShop.Models.ViewModels
@model CartItemViewModel
<section id="cart_items">
    <div class="container">
        <div class="breadcrumbs mb-4">
            <ol class="breadcrumb">
                <li><a href="#">Home</a></li>
                <li class="active">Shopping Cart</li>
            </ol>
        </div>
        <div class="table-responsive cart_info">
            <table class="table table-condensed text-center">
                <thead>
                    <tr class="cart_menu bg-light">
                        <th class="product">Product Name</th>
                        <th class="image">Image</th>
                        <th class="price">Price</th>
                        <th class="quantity">Quantity</th>
                        <th class="total">Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CartItems.Count > 0)
                    {
                        foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td class="cart_description">
                                    <h5>@item.ProductName</h5>
                                </td>
                                <td class="cart_product">
                                    <img src="~/media/products/@item.Image" width="80" alt="">
                                </td>
                                <td class="cart_price">
                                    <p>@item.Price.ToString("#,##0 VND")</p>
                                </td>
                                <td class="cart_quantity">
                                    <div class="d-flex justify-content-center">
                                        <a class="btn btn-default btn-sm" asp-controller="Cart" asp-action="Increase" asp-route-id="@item.ProductId"> + </a>
                                        <input class="cart_quantity_input mx-2 text-center" type="text" name="quantity" value="@item.Quantity" autocomplete="off" size="2" readonly>
                                        <a class="btn btn-success btn-sm" asp-controller="Cart" asp-action="Decrease" asp-route-id="@item.ProductId"> - </a>
                                    </div>
                                </td>
                                <td class="cart_total">
                                    <p class="cart_total_price">@Model.CartItems.Where(x => x.ProductId == @item.ProductId).Sum(x => x.Quantity * x.Price).ToString("#,##0 VND")</p>
                                </td>
                                <td class="cart_delete">
                                    <a class="btn btn-danger btn-sm" asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId">Remove</a>
                                </td>
                            </tr>
                        }
                        <tr>
                            <td colspan="6">
                                <div class="d-flex justify-content-between align-items-center">
                                    <p class="grand_total_text">Grand Total: <span class="cart_total_price">@Model.GrandTotal.ToString("#,##0 VND")</span></p>
                                    <div>
                                        <a class="btn btn-danger btn-sm" asp-controller="Cart" asp-action="Clear">Clear</a>
                                        @if (User.Identity?.IsAuthenticated ?? false)
                                        {
                                            <a class="btn btn-success btn-sm" asp-controller="Checkout" asp-action="Checkout">Checkout</a>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <h4>Your Cart is Empty</h4>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
